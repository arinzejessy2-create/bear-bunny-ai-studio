# Required for story planning and narration in this build
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
TEXT_MODEL=gpt-4o-mini
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral

# Connect your own ComfyUI server running a compatible Wan text-to-video workflow
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=workflows/wan_api_workflow.json
WAN_PROMPT_NODE_ID=
WAN_PROMPT_INPUT=text
